# 이 파일을 같은 폴더에 db.properties로 복사한 뒤 값을 채우세요.
# db.properties는 .gitignore에 들어 있어 커밋되지 않습니다.
db.url=jdbc:oracle:thin:@localhost:1521/XEPDB1
db.user=fixmap
db.password=change-me

# JPA(Hibernate)가 테이블을 만드는 방식: none, validate, update, create, create-drop
# 비워 두면 update. 개발 초기에는 update로 두고, 스키마를 새로 만들 때만 create를 쓴다.
jpa.ddl-auto=update

# 첨부 파일을 저장할 폴더 (저장 위치는 팀 미정). 비워 두면 {사용자 홈}/fixmap-uploads
# 배포할 때 지워지지 않도록 프로젝트(webapp) 밖의 폴더를 쓴다.
# upload.dir=C:/fixmap-uploads

# 관리자 접근 키(MVP용 임시 방식). 관리자는 /admin?key=키 로 처음 접속하면 이후 세션으로 열린다.
# 비워 두면 관리자 화면과 API가 모두 막힌다. 충분히 긴 값으로 정하고 공유하지 마세요.
admin.key=change-me

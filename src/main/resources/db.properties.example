# 이 파일을 같은 폴더에 db.properties로 복사한 뒤 값을 채우세요.
# db.properties는 .gitignore에 들어 있어 커밋되지 않습니다.
db.url=jdbc:oracle:thin:@localhost:1521/XEPDB1
db.user=fixmap
db.password=change-me

# JPA(Hibernate)가 테이블을 만드는 방식: none, validate, update, create, create-drop
# 비워 두면 update. 개발 초기에는 update로 두고, 스키마를 새로 만들 때만 create를 쓴다.
jpa.ddl-auto=update
